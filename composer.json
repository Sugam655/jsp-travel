{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "jeroennoten/laravel-adminlte": "^4.0",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "nwidart/laravel-modules": "^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.9",
        "laravel/breeze": "^2.4",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\Home\\": "Modules/Home/app/",
            "Modules\\Home\\Database\\Factories\\": "Modules/Home/database/factories/",
            "Modules\\Home\\Database\\Seeders\\": "Modules/Home/database/seeders/",
            "Modules\\Tours\\": "Modules/Tours/app/",
            "Modules\\Tours\\Database\\Factories\\": "Modules/Tours/database/factories/",
            "Modules\\Tours\\Database\\Seeders\\": "Modules/Tours/database/seeders/",
            "Modules\\Hotels\\": "Modules/Hotels/app/",
            "Modules\\Hotels\\Database\\Factories\\": "Modules/Hotels/database/factories/",
            "Modules\\Hotels\\Database\\Seeders\\": "Modules/Hotels/database/seeders/",
            "Modules\\Transport\\": "Modules/Transport/app/",
            "Modules\\Transport\\Database\\Factories\\": "Modules/Transport/database/factories/",
            "Modules\\Transport\\Database\\Seeders\\": "Modules/Transport/database/seeders/",
            "Modules\\Contact\\": "Modules/Contact/app/",
            "Modules\\Contact\\Database\\Factories\\": "Modules/Contact/database/factories/",
            "Modules\\Contact\\Database\\Seeders\\": "Modules/Contact/database/seeders/",
            "Modules\\Bookings\\": "Modules/Bookings/app/",
            "Modules\\Bookings\\Database\\Factories\\": "Modules/Bookings/database/factories/",
            "Modules\\Bookings\\Database\\Seeders\\": "Modules/Bookings/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
